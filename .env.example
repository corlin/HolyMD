# MySQL operational-state database. Article Markdown remains in the filesystem.
HOLYMD_DSN="mysql:host=127.0.0.1;dbname=holymd;charset=utf8mb4"
HOLYMD_DB_USERNAME=holymd
HOLYMD_DB_PASSWORD=change-me

# Optional OpenAI-compatible GEO review provider. Secrets remain outside Git.
HOLYMD_GEO_API_ENDPOINT="https://api.deepseek.com/v1/chat/completions"
HOLYMD_GEO_MODEL="deepseek-v4-flash"
# Generate both encrypted values without saving the plaintext key:
# HOLYMD_GEO_PLAINTEXT_KEY='sk-your-provider-key' php bin/holymd-admin.php encrypt-geo-key
# HOLYMD_GEO_API_CREDENTIAL="generated-nonce-and-ciphertext"
# HOLYMD_GEO_API_KEY="generated-32-byte-secretbox-key"
HOLYMD_GEO_TIMEOUT_SECONDS=30
HOLYMD_GEO_MAX_RESPONSE_BYTES=262144

# Public identity required for non-dry-run publishing. The language tag applies to all generated pages.
HOLYMD_SITE_NAME="REPLACE_WITH_PUBLICATION_NAME"
HOLYMD_SITE_URL="https://REPLACE_WITH_YOUR_DOMAIN"
HOLYMD_AUTHOR_NAME="REPLACE_WITH_AUTHOR_NAME"
HOLYMD_ABOUT="REPLACE_WITH_AUTHOR_BIOGRAPHY"
HOLYMD_SITE_LANGUAGE="zh-CN"
HOLYMD_TIMEZONE="Asia/Singapore"
HOLYMD_LLMS_TXT=1

# First admin: HOLYMD_ADMIN_PASSWORD='unique-password-at-least-12-characters' php bin/holymd-admin.php create --email admin@example.com --display-name 'Site administrator'
