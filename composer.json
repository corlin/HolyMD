{
  "name": "holymd/holymd",
  "description": "A static-first Markdown blog manager for shared PHP hosting.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-exif": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "league/commonmark": "^2.7",
    "php-di/php-di": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "HolyMD\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HolyMD\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests"
  },
  "config": {
    "sort-packages": true
  }
}
