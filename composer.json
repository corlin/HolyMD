{
  "name": "holymd/holymd",
  "description": "A GEO-native, static-first Markdown site engine for independent websites on shared PHP hosting.",
  "type": "project",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "llms-txt",
    "static-site",
    "markdown",
    "blog",
    "cms",
    "schema-org"
  ],
  "homepage": "https://github.com/corlin/HolyMD",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-exif": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "league/commonmark": "^2.7",
    "php-di/php-di": "^7.0",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "HolyMD\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HolyMD\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check": [
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
